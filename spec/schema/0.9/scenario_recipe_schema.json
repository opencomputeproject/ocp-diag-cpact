{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Test Scenario Spec",
  "type": "object",
  "properties": {
    "test_scenario": {
      "type": "object",
      "properties": {
        "test_id": {
          "type": "string"
        },
        "test_name": {
          "type": "string",
          "description": "Name of the test"
        },
        "test_group": {
          "type": "string",
          "description": "Grouping/category of the test"
        },
        "test_description": {
          "type": "string",
          "description": "Description of the test"
        },
        "map_file": {
          "type": "string"
        },
        "schema_version": {
          "type": "string"
        },
        "recipe_metadata": {
          "type": "object",
          "description": "Complete recipe metadata including versioning, classification, execution requirements, and outputs",
          "properties": {
            "recipe_id": {
              "type": "string",
              "description": "Unique global identifier for the recipe"
            },
            "recipe_revision": {
              "type": "string",
              "description": "Supplier-defined version of the recipe"
            },
            "supplier_id": {
              "type": "string",
              "description": "Identifier of the supplier providing the recipe"
            },
            "target_platform": {
              "type": "string",
              "description": "Identifier of the target CPU or platform family"
            },
            "package_integrity_hash": {
              "type": "object",
              "description": "Cryptographic hash to verify recipe integrity prior to execution",
              "properties": {
                "algorithm": {
                  "type": "string",
                  "description": "Hash algorithm used (e.g., SHA-256)"
                },
                "value": {
                  "type": "string",
                  "description": "Hexadecimal hash value"
                }
              }
            },
            "class_code": {
              "type": "string",
              "anyOf": [
                {
                  "enum": [
                    "L10",
                    "L11",
                    "L12"
                  ]
                },
                {
                  "pattern": "^OEM_.+"
                }
              ],
              "description": "Recipe lifecycle classification. Use L10, L11, or L12 for standard flows, or an OEM-specific value matching OEM_<identifier>."
            },
            "subclass_code": {
              "type": "string",
              "anyOf": [
                {
                  "enum": [
                    "BAT",
                    "SCREENING",
                    "BURN_IN",
                    "AGING",
                    "TRICKLE",
                    "DEBUG",
                    "STRESS_COMPUTE",
                    "STRESS_GPU",
                    "STRESS_TPU",
                    "STRESS_CACHE",
                    "STRESS_HBM",
                    "STRESS_MEMORY",
                    "STRESS_IO",
                    "STRESS_POWER_THERM"
                  ]
                },
                {
                  "pattern": "^STRESS_OEM_.+"
                }
              ],
              "description": "Diagnostic workload classification. Use one of the standard subclasses or an OEM-specific value matching STRESS_OEM_<identifier>."
            },
            "data_sensitivity": {
              "type": "string",
              "description": "Sensitivity classification of collected data"
            },
            "requested_connection_type": {
              "type": "string",
              "enum": [
                "LOCAL",
                "REMOTE"
              ],
              "description": "Access path"
            },
            "execution_target": {
              "type": "string",
              "enum": [
                "HOST_OS",
                "BMC"
              ],
              "description": "Execution environment responsible for running the recipe, either the host operating system or the BMC."
            },
            "os_environment_type": {
              "type": "string",
              "enum": [
                "BAREMETAL",
                "VM",
                "CONTAINER"
              ],
              "description": "Execution context (BAREMETAL, VM, CONTAINER)"
            },
            "nominal_execution_time": {
              "type": "integer",
              "description": "Estimated execution duration in seconds"
            },
            "package_size_mb": {
              "type": "integer",
              "description": "Size of diagnostic tools package in MB"
            },
            "tools_package_url": {
              "type": "string",
              "description": "Reference to diagnostic tools package"
            },
            "firmware_version_min": {
              "type": "string",
              "description": "Minimum required firmware version"
            },
            "output_format": {
              "type": "string",
              "enum": [
                "OCPTV"
              ],
              "description": "Supported output format (OCPTV)"
            },
            "log_url": {
              "type": "string",
              "description": "Log location (no hardcoded absolute paths)"
            },
            "system_requirements": {
              "type": "object",
              "description": "Minimum platform prerequisites that must be satisfied before the recipe can run.",
              "properties": {
                "bios_requirements": {
                  "type": "string",
                  "description": "Required BIOS configuration, settings, or firmware-level prerequisites."
                },
                "socket_count": {
                  "type": "integer",
                  "description": "Minimum number of CPU sockets required by the recipe."
                },
                "SMT": {
                  "type": "boolean",
                  "description": "Required simultaneous multithreading configuration for the target system."
                },
                "feature_flags": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "SGX",
                      "TME",
                      "CXL"
                    ]
                  },
                  "description": "Platform features that must be enabled for the recipe to run correctly."
                },
                "memory_size_min": {
                  "type": "integer",
                  "description": "Minimum installed system memory required by the recipe."
                },
                "network_bandwidth_min": {
                  "type": "integer",
                  "description": "Minimum network bandwidth required for recipe execution or data transfer."
                },
                "storage_temp_mb": {
                  "type": "integer",
                  "description": "Minimum temporary local storage required for logs, staging, or artifacts, in MB."
                },
                "execution_access_level": {
                  "type": "string",
                  "enum": [
                    "USER",
                    "ADMIN"
                  ],
                  "description": "Minimum privilege level required to execute the recipe."
                }
              },
              "additionalProperties": false
            },
            "security_constraints": {
              "type": "string",
              "description": "Security/privilege constraints"
            },
            "extended_artifacts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "REGISTER_DUMP",
                      "TRACE",
                      "MEMORY_DUMP",
                      "STDOUT",
                      "STDERR",
                      "JOURNAL",
                      "OTHER"
                    ]
                  }
                },
                "required": [
                  "url",
                  "type"
                ]
              },
              "description": "Additional output captures (logs, debug artifacts)"
            }
          },
          "required": [
            "recipe_id",
            "recipe_revision",
            "supplier_id",
            "target_platform",
            "package_integrity_hash",
            "class_code",
            "subclass_code",
            "data_sensitivity",
            "requested_connection_type",
            "execution_target",
            "os_environment_type",
            "nominal_execution_time",
            "package_size_mb",
            "tools_package_url",
            "firmware_version_min",
            "output_format",
            "log_url"
          ],
          "additionalProperties": false
        },
        "paths": {
          "type": "object",
          "items": {
            "type": "object",
            "patternProperties": {
              "^[A-Za-z0-9]+$": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "docker": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "container_name": {
                "type": "string"
              },
              "container_image": {
                "type": "string"
              },
              "shell": {
                "type": "string"
              },
              "container_location": {
                "type": "string",
                "enum": [
                  "local",
                  "remote"
                ]
              },
              "connection_type": {
                "type": "string",
                "enum": [
                  "Local",
                  "Inband",
                  "RackManager",
                  "NodeManager",
                  "both"
                ]
              },
              "connection": {
                "type": "string",
                "enum": [
                  "local",
                  "redfish",
                  "ssh"
                ]
              },
              "use_sudo": {
                "type": "boolean"
              }
            },
            "required": [
              "container_name",
              "container_image",
              "connection_type",
              "connection"
            ],
            "additionalProperties": false
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "test_steps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "step_id": {
                "type": "string"
              },
              "step_name": {
                "type": "string"
              },
              "step_description": {
                "type": "string"
              },
              "entry_criteria": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "expression": {
                      "type": "string"
                    },
                    "entry_criteria_note": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "expression"
                  ],
                  "additionalProperties": false
                }
              },
              "container_name": {
                "type": "string"
              },
              "connection_type": {
                "type": "string",
                "enum": [
                  "Local",
                  "Inband",
                  "RackManager",
                  "NodeManager",
                  "both"
                ]
              },
              "connection": {
                "type": "string",
                "enum": [
                  "local",
                  "redfish",
                  "ssh"
                ]
              },
              "step_type": {
                "type": "string",
                "enum": [
                  "command_execution",
                  "log_analysis",
                  "invoke_scenario"
                ]
              }
            },
            "required": [
              "step_id",
              "step_name",
              "step_type",
              "connection_type",
              "connection"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "step_type": {
                      "const": "command_execution"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "step_command": {
                      "type": "string"
                    },
                    "use_sudo": {
                      "type": "boolean"
                    },
                    "method": {
                      "type": "string"
                    },
                    "body": {},
                    "headers": {},
                    "duration": {
                      "type": "integer"
                    },
                    "continue": {
                      "type": "boolean"
                    },
                    "loop": {
                      "type": "integer"
                    },
                    "validator_type": {
                      "type": "string"
                    },
                    "expected_output": {
                      "type": "string"
                    },
                    "expected_output_path": {
                      "type": "string"
                    },
                    "output_analysis": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "regex": {
                            "type": "string"
                          },
                          "parameter_to_set": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "regex",
                          "parameter_to_set"
                        ],
                        "additionalProperties": false
                      },
                      "minItems": 1
                    }
                  },
                  "required": [
                    "step_command",
                    "validator_type"
                  ],
                  "additionalProperties": true
                }
              },
              {
                "if": {
                  "properties": {
                    "step_type": {
                      "const": "log_analysis"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "log_analysis_path": {
                      "type": "string"
                    },
                    "validator_type": {
                      "type": "string"
                    },
                    "diagnostic_analysis": {
                      "type": "array",
                      "items": {
                        "oneOf": [
                          {
                            "type": "object",
                            "properties": {
                              "search_string": {
                                "type": "string"
                              },
                              "diagnostic_result_code": {
                                "type": "string"
                              },
                              "parameter_to_set": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "search_string",
                              "diagnostic_result_code"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "diagnostic_search_string": {
                                "type": "string"
                              },
                              "parameter_to_set": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "diagnostic_search_string"
                            ],
                            "additionalProperties": false
                          }
                        ]
                      },
                      "minItems": 1
                    }
                  },
                  "required": [
                    "log_analysis_path",
                    "validator_type"
                  ],
                  "additionalProperties": true
                }
              },
              {
                "if": {
                  "properties": {
                    "step_type": {
                      "const": "invoke_scenario"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "scenario_path": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "scenario_path"
                  ],
                  "additionalProperties": true
                }
              }
            ],
            "additionalProperties": true
          }
        }
      },
      "required": [
        "test_name",
        "test_group",
        "test_steps",
        "recipe_metadata",
        "map_file",
        "schema_version"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "test_scenario"
  ],
  "additionalProperties": false
}